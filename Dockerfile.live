ARG TEST_IMAGE=arke-test:3.12
FROM ${TEST_IMAGE}
ARG CLAUDE_VERSION=2.1.310
ARG CODEX_VERSION=0.172.0
RUN npm install --global @anthropic-ai/claude-code@${CLAUDE_VERSION} @openai/codex@${CODEX_VERSION} \
    && useradd --create-home arke-live \
    && chown -R arke-live:arke-live /arke
USER arke-live
ENV ARKE_LIVE_CONTAINER=1
ENTRYPOINT ["python3", "-m", "tests.live_smoke"]
