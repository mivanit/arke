# Native worker image; can also run an owner-only service. Login happens at runtime.
FROM docker.io/node:22-bookworm-slim AS node
FROM docker.io/python:3.12-bookworm
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=ghcr.io/astral-sh/uv:0.13.4 /uv /usr/local/bin/uv
ARG CLAUDE_VERSION=2.1.310
ARG CODEX_VERSION=0.172.0
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && npm install --global @anthropic-ai/claude-code@${CLAUDE_VERSION} @openai/codex@${CODEX_VERSION} \
    && useradd --create-home --uid 1000 agent \
    && mkdir /state /workspace && chown agent:agent /state /workspace
WORKDIR /app
COPY pyproject.toml uv.lock LICENSE README.md ./
COPY arke ./arke
COPY web ./web
COPY container.agent.toml ./container.agent.toml
ENV UV_CACHE_DIR=/app/.local/uv-cache UV_PYTHON_DOWNLOADS=never
RUN uv sync --locked --all-extras --no-dev
USER agent
ENV HOME=/home/agent PATH=/app/.venv/bin:/usr/local/bin:/usr/bin:/bin
EXPOSE 7780
ENTRYPOINT ["python", "-m", "arke.webapp"]
CMD ["--config", "/app/container.agent.toml"]
